{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": "${PINNED_EXECUTION_TASK_DEFINITION_ARN}",
      "Condition": {"ArnEquals": {"ecs:cluster": "${PAPER_CLUSTER_ARN}"}}
    },
    {
      "Effect": "Allow",
      "Action": "ecs:DescribeTasks",
      "Resource": "${PAPER_CLUSTER_TASK_ARN_PATTERN}"
    },
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": ["${EXECUTION_TASK_ROLE_ARN}", "${EXECUTION_TASK_EXECUTION_ROLE_ARN}"],
      "Condition": {"StringEquals": {"iam:PassedToService": "ecs-tasks.amazonaws.com"}}
    }
  ]
}
